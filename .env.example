# Copy to .env for local ./deploy.sh (never commit .env)

# Pantry droplet IP: (cd ../Pantry/terraform && terraform output -raw droplet_ip)
DROPLET_HOST=

# Classic GitHub PAT with read:packages + write:packages (for GHCR push/pull)
GITHUB_TOKEN=

# --- ClubDue app (local dev) ---
# docker compose up -d db
APP_ENV=development
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://clubdue:clubdue@127.0.0.1:5433/clubdue?sslmode=disable
SESSION_SECRET=change-me-in-production
BOOTSTRAP_SHOP_NAME=Demo HVAC Shop
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=changeme
ENABLE_DEV_ROUTES=1

# Runtime limits (P0.3 applies these at the HTTP boundary).
MAX_REQUEST_BODY_BYTES=8388608
MAX_MULTIPART_MEMORY_BYTES=1048576
AUTH_MAX_ATTEMPTS=5
AUTH_THROTTLE_WINDOW=5m
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Production-only, comma-separated invite allowlist. Keep actual addresses in
# the root-only production environment file, never this example.
# SIGNUP_ALLOWLIST=
