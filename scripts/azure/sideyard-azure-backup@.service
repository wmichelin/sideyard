[Unit]
Description=Sideyard %i encrypted Azure backup
After=docker.service network-online.target
Wants=network-online.target
OnFailure=sideyard-backup-monitor@%i.service

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/opt/clubdue/azure/%i-backups.env
ExecStart=/bin/bash /opt/clubdue/azure-tools/azure/run-backup.sh %i
TimeoutStartSec=20min
