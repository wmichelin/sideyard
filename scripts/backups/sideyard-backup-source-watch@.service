[Unit]
Description=Sideyard %i off-host receipt freshness monitor on the source droplet

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/sideyard-backup/monitor-source.py %i
TimeoutStartSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sideyard-backup-receipts
