[Unit]
Description=Independent Sideyard %i backup freshness and failure check on G5

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/sideyard-backup/monitor.py %i
TimeoutStartSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sideyard-backup
