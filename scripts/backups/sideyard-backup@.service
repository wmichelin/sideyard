[Unit]
Description=Sideyard %i encrypted off-host backup on G5
Wants=network-online.target
After=network-online.target
OnFailure=sideyard-backup-watch@%i.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/sideyard-backup/run-backup.py %i
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/sideyard-pg /var/lib/sideyard-backup /etc/sideyard-backup
